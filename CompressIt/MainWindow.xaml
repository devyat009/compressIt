<ui:FluentWindow x:Class="CompressIt.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
                  xmlns:controls="clr-namespace:CompressIt.Controls"
                  xmlns:conv="clr-namespace:CompressIt.Converters"
                  Title="CompressIt"
                  Width="1280"
                  Height="800"
                  MinWidth="980"
                  MinHeight="640"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  AllowDrop="True"
                  DragOver="Window_DragOver"
                  Drop="Window_Drop"
                  KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:PlayPauseSymbolConverter x:Key="PlayPauseSymbol" />
        <conv:MuteSymbolConverter x:Key="MuteSymbol" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Title Bar -->
        <ui:TitleBar x:Name="AppTitleBar"
                    Grid.Row="0"
                    Title="CompressIt"
                    Height="44">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/CompressIt.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding CurrentVideo.FileName}"
                              Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}"
                              VerticalAlignment="Center"
                              Foreground="#94A3B8"
                              FontSize="12"
                              MaxWidth="260"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,0,12,0" />

                    <ui:Button Command="{Binding OpenSettingsCommand}"
                              Appearance="Secondary"
                              Padding="10,4"
                              Margin="0,0,6,0"
                              ToolTip="Switch between GPU and CPU encoding">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="14" Foreground="#4ADE80" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HardwareModeBadge}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Click="OpenVideoButton_Click"
                              Appearance="Secondary"
                              Padding="10,4"
                              Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Open Video" FontSize="12" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Command="{Binding OpenAuthorGitHubCommand}"
                               Appearance="Transparent"
                               Padding="8,4"
                               Margin="0,0,4,0"
                               ToolTip="Author: Devyat009 (https://github.com/devyat009/)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#CBD5E1" Margin="0,0,5,0"
                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                            <TextBlock Text="Devyat009" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Command="{Binding OpenSettingsCommand}"
                              Appearance="Transparent"
                              Padding="8,4"
                              ToolTip="Settings">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Error InfoBar -->
        <ui:InfoBar Grid.Row="1"
                    Title="Notice"
                    Message="{Binding ErrorBannerText}"
                    Severity="Error"
                    IsOpen="{Binding HasErrorBanner, Mode=TwoWay}"
                    Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVis}}"
                    IsClosable="True"
                    Margin="12,4,12,0" />

        <!-- Main Workspace -->
        <Grid Grid.Row="2" Margin="12,6,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Side Compression Options Drawer -->
            <Border Grid.Column="0"
                    Width="296"
                    Margin="0,0,12,0"
                    CornerRadius="12"
                    Background="#14FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Visibility="{Binding IsDrawerExpanded, Converter={StaticResource BoolToVis}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right"
                                  Command="{Binding ToggleDrawerCommand}"
                                  Appearance="Transparent"
                                  Padding="6"
                                  ToolTip="Collapse drawer">
                            <ui:SymbolIcon Symbol="PanelLeftContract24" FontSize="16" />
                        </ui:Button>
                        <StackPanel>
                            <TextBlock Text="Compression Options" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ActiveEncoderHint}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Drawer Controls -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Codec -->
                            <TextBlock Text="Codec" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding CodecOptions}"
                                      SelectedItem="{Binding SelectedCodecOption}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedCodecOption.Description}"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,0,0,14" />

                            <!-- Speed -->
                            <TextBlock Text="Encoding Speed" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SelectedSpeedOption}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,14" />

                            <!-- FPS -->
                            <TextBlock Text="Frame Rate (FPS)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding FpsOptions}"
                                      SelectedItem="{Binding SelectedFpsOption}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,16" />

                            <!-- Quality Slider with Low / Medium / High + Percentage -->
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding QualityTierLabel}"
                                                  Foreground="{Binding QualityTierBrush}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding QualityPercentLabel}"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="#FFFFFFFF"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Quality" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                            </DockPanel>

                            <Slider Minimum="1"
                                    Maximum="100"
                                    Value="{Binding QualityPercent, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,2" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Low" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Medium" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="High" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Advanced Expander -->
                            <Expander Header="Advanced Output" IsExpanded="False" Margin="0,0,0,8">
                                <StackPanel Margin="0,10,0,4">
                                    <TextBlock Text="Container Format" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ContainerOptions}"
                                              SelectedItem="{Binding SelectedContainerOption}"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,0,10" />

                                    <TextBlock Text="Resolution" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                              SelectedItem="{Binding SelectedResolutionOption}"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,0,10" />

                                    <TextBlock Text="Audio" FontSize="11" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AudioOptions}"
                                              SelectedItem="{Binding SelectedAudioOption}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Background="#18FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Source Video" FontSize="10" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding SourceVideoSpecsText}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <ui:Button Command="{Binding OpenExportConfigCommand}"
                                  IsEnabled="{Binding HasVideo}"
                                  Appearance="Primary"
                                  HorizontalAlignment="Stretch"
                                  Height="40"
                                  FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Export &amp; Compress" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapsed Left Rail (outside VideoView airspace so it is always visible & clickable) -->
            <Border Grid.Column="0"
                    Width="48"
                    Margin="0,0,12,0"
                    CornerRadius="12"
                    Background="#14FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    Visibility="{Binding IsDrawerExpanded, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel Margin="6,12">
                    <ui:Button DockPanel.Dock="Top"
                              Command="{Binding ToggleDrawerCommand}"
                              Appearance="Transparent"
                              HorizontalAlignment="Center"
                              Padding="8"
                              ToolTip="Expand compression options">
                        <ui:SymbolIcon Symbol="PanelLeftExpand24" FontSize="18" />
                    </ui:Button>

                    <ui:Button DockPanel.Dock="Bottom"
                              Command="{Binding OpenExportConfigCommand}"
                              IsEnabled="{Binding HasVideo}"
                              Appearance="Primary"
                              HorizontalAlignment="Center"
                              Padding="8"
                              ToolTip="Export &amp; Compress">
                        <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="18" />
                    </ui:Button>

                    <TextBlock Text="OPTIONS"
                              FontSize="10"
                              FontWeight="SemiBold"
                              Foreground="#64748B"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Right Main Area: Video Player + Bottom Timeline -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="162" />
                </Grid.RowDefinitions>

                <!-- Video Stage -->
                <Border Grid.Row="0"
                        CornerRadius="12"
                        Background="#FF090D14"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Empty State Dropzone -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasVideo, Converter={StaticResource InverseBoolToVis}}">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#164ADE80" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="34" Foreground="#4ADE80" />
                            </Border>
                            <TextBlock Text="Open or Drop a Video File"
                                      FontSize="20"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Cut segments on the timeline and compress with GPU acceleration"
                                      FontSize="13"
                                      Foreground="#94A3B8"
                                      HorizontalAlignment="Center"
                                      Margin="0,6,0,20" />
                            <ui:Button Click="OpenVideoButton_Click"
                                      Appearance="Primary"
                                      HorizontalAlignment="Center"
                                      Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Choose Video File" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- LibVLC VideoView (collapsed automatically while overlays are open) -->
                        <vlc:VideoView x:Name="MediaVideoView"
                                      Visibility="{Binding IsVideoPlayerVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Playback Transport Bar -->
                <Border Grid.Row="1"
                        Margin="0,8,0,8"
                        Padding="12,6"
                        CornerRadius="10"
                        Background="#14FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding StepBackwardCommand}"
                                      IsEnabled="{Binding HasVideo}"
                                      Appearance="Transparent"
                                      Padding="8,6"
                                      ToolTip="Step back 1s (Left Arrow)">
                              <ui:SymbolIcon Symbol="Rewind24" FontSize="16" />
                            </ui:Button>

                            <ui:Button Command="{Binding TogglePlayPauseCommand}"
                                      IsEnabled="{Binding HasVideo}"
                                      Appearance="Primary"
                                      Padding="12,6"
                                      Margin="4,0"
                                      ToolTip="Play / Pause (Space)">
                                <ui:SymbolIcon Symbol="{Binding IsPlaying, Converter={StaticResource PlayPauseSymbol}}" FontSize="16" />
                            </ui:Button>

                            <ui:Button Command="{Binding StepForwardCommand}"
                                      IsEnabled="{Binding HasVideo}"
                                      Appearance="Transparent"
                                      Padding="8,6"
                                      ToolTip="Step forward 1s (Right Arrow)">
                                <ui:SymbolIcon Symbol="FastForward24" FontSize="16" />
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                  Text="{Binding TimecodeDisplay}"
                                  FontFamily="Consolas"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="#E2E8F0" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Click="ToggleMuteButton_Click"
                                      Appearance="Transparent"
                                      Padding="6"
                                      ToolTip="Mute / Unmute">
                                <ui:SymbolIcon Symbol="{Binding IsMuted, Converter={StaticResource MuteSymbol}}" FontSize="16" />
                            </ui:Button>
                            <Slider Width="90"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Timeline & Cut Controls -->
                <Border Grid.Row="2"
                        CornerRadius="12"
                        Background="#14FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Timeline Action Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#18FFFFFF"
                                        CornerRadius="6"
                                        Padding="4,2"
                                        Margin="0,0,12,0"
                                        ToolTip="Hold Alt + Mouse Wheel on timeline to zoom">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Command="{Binding ZoomOutTimelineCommand}"
                                                  IsEnabled="{Binding HasVideo}"
                                                  Appearance="Transparent"
                                                  Padding="6,2"
                                                  ToolTip="Zoom out timeline (Alt + Scroll Down)">
                                            <ui:SymbolIcon Symbol="ZoomOut24" FontSize="13" />
                                        </ui:Button>
                                        <ui:Button Command="{Binding ResetTimelineZoomCommand}"
                                                  IsEnabled="{Binding HasVideo}"
                                                  Appearance="Transparent"
                                                  Padding="6,2"
                                                  ToolTip="Reset timeline zoom to 1.0x">
                                            <TextBlock Text="{Binding TimelineZoomLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                        </ui:Button>
                                        <ui:Button Command="{Binding ZoomInTimelineCommand}"
                                                  IsEnabled="{Binding HasVideo}"
                                                  Appearance="Transparent"
                                                  Padding="6,2"
                                                  ToolTip="Zoom in timeline (Alt + Scroll Up)">
                                            <ui:SymbolIcon Symbol="ZoomIn24" FontSize="13" />
                                        </ui:Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding SegmentsSummaryText}"
                                          VerticalAlignment="Center"
                                          FontSize="12"
                                          Foreground="#94A3B8" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding CutAtPlayheadCommand}"
                                          IsEnabled="{Binding CanSplitAtPlayhead}"
                                          Appearance="Secondary"
                                          Padding="12,5"
                                          Margin="0,0,8,0"
                                          ToolTip="Cut segment at the playhead | (Shortcut: C or S)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Cut24" FontSize="15" Foreground="#4ADE80" Margin="0,0,6,0" />
                                        <TextBlock Text="Cut at |" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding ToggleSelectedSegmentIncludeCommand}"
                                          IsEnabled="{Binding HasVideo}"
                                          Appearance="Secondary"
                                          Padding="10,5"
                                          Margin="0,0,8,0"
                                          ToolTip="Keep or exclude selected segment (or double-click segment)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedSegmentActionText}" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding MergeSelectedWithNextCommand}"
                                          IsEnabled="{Binding CanMergeWithNext}"
                                          Appearance="Transparent"
                                          Padding="10,5"
                                          Margin="0,0,6,0"
                                          ToolTip="Merge selected segment with the next segment">
                                    <TextBlock Text="Merge Next" FontSize="12" />
                                </ui:Button>

                                <ui:Button Command="{Binding ResetCutsCommand}"
                                          IsEnabled="{Binding HasVideo}"
                                          Appearance="Transparent"
                                          Padding="10,5">
                                    <TextBlock Text="Reset Cuts" FontSize="12" Foreground="#94A3B8" />
                                </ui:Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Interactive Timeline -->
                        <controls:TimelineControl x:Name="VideoTimeline"
                                                  Grid.Row="1"
                                                  Duration="{Binding VideoDuration}"
                                                  Position="{Binding PlayheadPosition, Mode=TwoWay}"
                                                  Segments="{Binding Segments}"
                                                  SelectedSegmentId="{Binding SelectedSegmentId}"
                                                  ThumbnailPaths="{Binding ThumbnailPaths}"
                                                  ZoomLevel="{Binding TimelineZoomLevel, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- OVERLAY 1: First-Initialization FFmpeg Download -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsInitializingFfmpeg, Converter={StaticResource BoolToVis}}">
            <Border Width="480"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF161B22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#204ADE80" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" Foreground="#4ADE80" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Setting up CompressIt" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="First-time FFmpeg initialization" FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding FfmpegDownloadStatus}"
                              FontSize="13"
                              Foreground="#E2E8F0"
                              Margin="0,4,0,10" />

                    <ProgressBar Value="{Binding FfmpegDownloadPercent}"
                                Minimum="0"
                                Maximum="100"
                                Height="8"
                                Margin="0,0,0,8" />

                    <TextBlock Text="{Binding FfmpegDownloadPercent, StringFormat={}{0:0}%}"
                              FontSize="12"
                              Foreground="#4ADE80"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Right" />

                    <StackPanel Visibility="{Binding FfmpegDownloadError, Converter={StaticResource NullToVis}}" Margin="0,12,0,0">
                        <TextBlock Text="{Binding FfmpegDownloadError}"
                                  Foreground="#F87171"
                                  FontSize="12"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Click="BrowseFfmpegButton_Click" Appearance="Secondary" Margin="0,0,8,0">
                                <TextBlock Text="Locate Existing FFmpeg..." />
                            </ui:Button>
                            <ui:Button Command="{Binding RetryFfmpegDownloadCommand}" Appearance="Primary">
                                <TextBlock Text="Retry Download" />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 2: Export Configuration Panel (Merge Segments vs Separate) -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsExportConfigOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF161B22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="26">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right" Command="{Binding CloseExportConfigCommand}" Appearance="Transparent" Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </ui:Button>
                        <StackPanel>
                            <TextBlock Text="Export &amp; Compress Configuration" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExportSummaryText}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Segments Summary List -->
                    <TextBlock Text="Segments to Export" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="10" MaxHeight="110" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding IncludedSegmentDescriptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#E2E8F0" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Merge Option when >1 segments -->
                    <StackPanel Visibility="{Binding HasMultipleIncludedSegments, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="Multiple Segments Handling" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />

                        <RadioButton IsChecked="{Binding MergeSegments, Mode=TwoWay}"
                                    GroupName="MergeChoice"
                                    Margin="0,0,0,6">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Merge segments into a single video" FontWeight="SemiBold" />
                                <TextBlock Text="Concatenates all kept segments seamlessly into one compressed output file." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton IsChecked="{Binding SeparateSegments, Mode=TwoWay}"
                                    GroupName="MergeChoice">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Export segments separately (do not merge)" FontWeight="SemiBold" />
                                <TextBlock Text="Saves each kept segment as its own compressed file (_part1, _part2, ...)." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Output Location & Filename -->
                    <TextBlock Text="Output Folder" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding ExportOutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" Click="BrowseOutputFolderButton_Click" Appearance="Secondary" Padding="12,8">
                            <TextBlock Text="Browse..." />
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="Output File Name" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding ExportFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Command="{Binding CloseExportConfigCommand}" Appearance="Secondary" Margin="0,0,10,0" Padding="16,8">
                            <TextBlock Text="Cancel" />
                        </ui:Button>
                        <ui:Button Command="{Binding StartExportCommand}" Appearance="Primary" Padding="20,8" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Start Compression" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 3: Export Progress -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
            <Border Width="480"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF161B22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="Compressing Video..." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ExportStatusText}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <ProgressBar Value="{Binding ExportProgressPercent}"
                                Minimum="0"
                                Maximum="100"
                                Height="10"
                                Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,18">
                        <TextBlock DockPanel.Dock="Right"
                                  Text="{Binding ExportProgressPercent, StringFormat={}{0:0.0}%}"
                                  FontWeight="Bold"
                                  Foreground="#4ADE80" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExportSpeedText}" FontSize="12" Foreground="#94A3B8" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ExportEtaText}" FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>
                    </DockPanel>

                    <ui:Button Command="{Binding CancelExportCommand}" Appearance="Secondary" HorizontalAlignment="Right" Padding="16,8">
                        <TextBlock Text="Cancel" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 4: CompressO-Style Comparison Result -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsResultOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF131820"
                    BorderBrush="#334ADE80"
                    BorderThickness="1"
                    Padding="28">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <Border DockPanel.Dock="Right" Background="#224ADE80" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultSavedBadgeText}" Foreground="#4ADE80" FontWeight="Bold" FontSize="13" />
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="26" Foreground="#4ADE80" Margin="0,0,10,0" />
                            <TextBlock Text="Compression Complete" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>

                    <!-- CompressO-style White -> Green Size Comparison -->
                    <Border Background="#FF0B0F17"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,20"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="FROM" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ResultOriginalSizeText}"
                                          FontSize="30"
                                          FontWeight="Bold"
                                          Foreground="#FFFFFFFF"
                                          HorizontalAlignment="Center" />
                            </StackPanel>

                            <ui:SymbolIcon Grid.Column="1"
                                          Symbol="ArrowRight24"
                                          FontSize="26"
                                          Foreground="#94A3B8"
                                          Margin="16,12,16,0"
                                          VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="TO" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ResultCompressedSizeText}"
                                          FontSize="30"
                                          FontWeight="Bold"
                                          Foreground="#4ADE80"
                                          HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ResultDetailText}"
                              FontSize="12"
                              Foreground="#94A3B8"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,14" />

                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="10" MaxHeight="90" Margin="0,0,0,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LastResult.OutputFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Command="{Binding CloseResultCommand}" Appearance="Secondary" Margin="0,0,8,0" Padding="14,8">
                            <TextBlock Text="Back to Editor" />
                        </ui:Button>
                        <ui:Button Command="{Binding ShowOutputInExplorerCommand}" Appearance="Secondary" Margin="0,0,8,0" Padding="14,8">
                            <TextBlock Text="Show in Folder" />
                        </ui:Button>
                        <ui:Button Command="{Binding OpenFirstOutputFileCommand}" Appearance="Primary" Padding="16,8" FontWeight="SemiBold">
                            <TextBlock Text="Play Result" />
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 5: Settings Panel (GPU / CPU Toggle, Shell Integration, Updates, FFmpeg, Author) -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="540"
                    MaxHeight="660"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF161B22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right" Command="{Binding CloseSettingsCommand}" Appearance="Transparent" Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </ui:Button>
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Encoding Engine: GPU (Default) vs CPU -->
                            <TextBlock Text="Compression Hardware" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8" />

                            <RadioButton IsChecked="{Binding UseGpuAcceleration, Mode=TwoWay}"
                                        GroupName="HardwareMode"
                                        Margin="0,0,0,8">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="GPU Hardware Acceleration (Default)" FontWeight="SemiBold" />
                                    <TextBlock Text="Fastest encoding using NVIDIA NVENC, AMD AMF, or Intel QuickSync." FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton IsChecked="{Binding UseCpuEncoding, Mode=TwoWay}"
                                        GroupName="HardwareMode"
                                        Margin="0,0,0,10">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="CPU Software Encoding" FontWeight="SemiBold" />
                                    <TextBlock Text="Uses libx264 / libx265 / libsvtav1 / libvpx-vp9 for maximum compatibility &amp; compression ratio." FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                            </RadioButton>

                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <TextBlock Text="{Binding HardwareSummaryText}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                            </Border>

                            <!-- Windows Shell Integration -->
                            <TextBlock Text="Windows Explorer Integration" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,16">
                                <ui:ToggleSwitch DockPanel.Dock="Right"
                                                IsChecked="{Binding ShellIntegrationEnabled, Mode=TwoWay}"
                                                VerticalAlignment="Center" />
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Open in CompressIt" FontSize="13" />
                                    <TextBlock Text="Adds CompressIt to Windows 'Open with' &amp; video file context menus." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Updates & Release Checker -->
                            <TextBlock Text="Updates" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <ui:Button DockPanel.Dock="Right"
                                                  Command="{Binding CheckForUpdatesCommand}"
                                                  IsEnabled="{Binding IsNotCheckingUpdates}"
                                                  Appearance="Secondary"
                                                  Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Check for Updates" FontSize="12" />
                                            </StackPanel>
                                        </ui:Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="CompressIt " FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AppVersionText}" FontSize="13" FontWeight="SemiBold" Foreground="#4ADE80" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,8,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right"
                                                        IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"
                                                        VerticalAlignment="Center" />
                                        <TextBlock Text="Automatically check GitHub releases on startup"
                                                  FontSize="12"
                                                  Foreground="#CBD5E1"
                                                  VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- FFmpeg Info -->
                            <TextBlock Text="FFmpeg Engine" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding FfmpegPathDisplay}" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FfmpegVersionText}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ui:Button Command="{Binding RedownloadFfmpegCommand}" Appearance="Secondary" Margin="0,0,8,0">
                                    <TextBlock Text="Re-download FFmpeg" />
                                </ui:Button>
                                <ui:Button Click="BrowseFfmpegButton_Click" Appearance="Transparent">
                                    <TextBlock Text="Choose Folder..." />
                                </ui:Button>
                            </StackPanel>

                            <!-- Author & GitHub Link -->
                            <TextBlock Text="About" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,10">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right"
                                              Command="{Binding OpenAuthorGitHubCommand}"
                                              Appearance="Secondary"
                                              Padding="12,6"
                                              ToolTip="Open https://github.com/devyat009/">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Stretch="Uniform" Fill="#FFFFFFFF" Margin="0,0,6,0"
                                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                                            <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ui:Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Author: " FontSize="12" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding AuthorNameText}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AuthorGitHubUrl}" FontSize="11" Foreground="#4ADE80" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button Grid.Row="2"
                              Command="{Binding CloseSettingsCommand}"
                              Appearance="Primary"
                              HorizontalAlignment="Right"
                              Margin="0,14,0,0"
                              Padding="18,8">
                        <TextBlock Text="Done" />
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- OVERLAY 6: Updating Popup (GitHub Release Checker & Auto-Updater) -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Background="#CC090D14"
              Visibility="{Binding IsUpdatePopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#FF161B22"
                    BorderBrush="#444ADE80"
                    BorderThickness="1"
                    Padding="26">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right"
                                  Command="{Binding DismissUpdatePopupCommand}"
                                  IsEnabled="{Binding IsNotDownloadingUpdate}"
                                  Appearance="Transparent"
                                  Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                        </ui:Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#204ADE80" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="#4ADE80" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Update Available" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdateVersionTransitionText}" FontSize="13" FontWeight="Bold" Foreground="#4ADE80" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding AvailableUpdate.ReleaseTitle}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="#E2E8F0"
                              Margin="0,0,0,6" />

                    <Border Background="#12FFFFFF" CornerRadius="8" Padding="12" MaxHeight="160" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}"
                                      FontSize="12"
                                      Foreground="#CBD5E1"
                                      TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Download Progress -->
                    <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="{Binding UpdateDownloadStatus}" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding UpdateDownloadPercent}" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat={}{0:0}%}"
                                  FontSize="11"
                                  Foreground="#4ADE80"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Right" />
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateErrorText}"
                              Visibility="{Binding UpdateErrorText, Converter={StaticResource NullToVis}}"
                              Foreground="#F87171"
                              FontSize="12"
                              TextWrapping="Wrap"
                              Margin="0,0,0,12" />

                    <DockPanel>
                        <ui:Button Command="{Binding OpenUpdateReleasePageCommand}" Appearance="Transparent" Padding="10,8">
                            <TextBlock Text="View on GitHub" FontSize="12" />
                        </ui:Button>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Command="{Binding DismissUpdatePopupCommand}"
                                      IsEnabled="{Binding IsNotDownloadingUpdate}"
                                      Appearance="Secondary"
                                      Margin="0,0,8,0"
                                      Padding="14,8">
                                <TextBlock Text="Later" />
                            </ui:Button>
                            <ui:Button Command="{Binding DownloadAndInstallUpdateCommand}"
                                      IsEnabled="{Binding IsNotDownloadingUpdate}"
                                      Appearance="Primary"
                                      Padding="18,8"
                                      FontWeight="SemiBold">
                                <TextBlock Text="Download &amp; Install" />
                            </ui:Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
