<UserControl x:Class="CompressIt.Controls.TimelineControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Background="Transparent"
            ClipToBounds="False"
            PreviewMouseWheel="UserControl_PreviewMouseWheel">
    <ScrollViewer x:Name="TimelineScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid x:Name="ZoomContentHost" Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Time Ruler -->
            <Canvas x:Name="RulerCanvas" Grid.Row="0" IsHitTestVisible="False" />

            <!-- Interactive Track -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="#FF0D1117"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid x:Name="TrackHost"
                      Background="Transparent"
                      MouseLeftButtonDown="Track_MouseLeftButtonDown"
                      MouseMove="Track_MouseMove"
                      MouseLeftButtonUp="Track_MouseLeftButtonUp">

                    <!-- Thumbnail filmstrip -->
                    <ItemsControl x:Name="ThumbnailsStrip" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Stretch="UniformToFill" Opacity="0.48" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Segment overlays + draggable < and > edge handles -->
                    <Canvas x:Name="SegmentsCanvas" Background="{x:Null}" />

                    <!-- Playhead "|" indicator -->
                    <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False">
                        <Border x:Name="PlayheadTimePill"
                                Background="#FF22C55E"
                                CornerRadius="4"
                                Padding="5,1"
                                Canvas.Top="2">
                            <TextBlock x:Name="PlayheadTimeText"
                                      Text="00:00.00"
                                      FontSize="10"
                                      FontWeight="SemiBold"
                                      Foreground="#FF07130C" />
                        </Border>
                        <Line x:Name="PlayheadLine"
                              X1="0" X2="0"
                              Y1="0" Y2="100"
                              Stroke="#FFFFFFFF"
                              StrokeThickness="2" />
                        <Polygon x:Name="PlayheadHead"
                                Points="-6,0 6,0 0,8"
                                Fill="#FFFFFFFF" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
