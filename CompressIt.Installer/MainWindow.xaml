<ui:FluentWindow x:Class="CompressIt.Installer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="CompressIt Setup"
                 Width="540"
                 Height="450"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CompressIt Setup" Height="40" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="28,12,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <ui:Button DockPanel.Dock="Right"
                          Click="GitHubAuthor_Click"
                          Appearance="Transparent"
                          Padding="8,4"
                          VerticalAlignment="Center"
                          ToolTip="https://github.com/devyat009/">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#E2E8F0" Margin="0,0,6,0"
                              Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                        <TextBlock Text="Devyat009" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                    </StackPanel>
                </ui:Button>

                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/CompressIt.ico" Width="40" Height="40" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Install CompressIt" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionSubtitle" Text="v1.0.0 • Video Cutter &amp; GPU Compressor" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Step 1: Configuration -->
            <StackPanel x:Name="OptionsPanel" Grid.Row="1">
                <TextBlock Text="Install Location" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="InstallPathBox" Grid.Column="0" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1" Click="BrowseFolder_Click" Appearance="Secondary" Padding="12,8">
                        <TextBlock Text="Browse..." />
                    </ui:Button>
                </Grid>

                <TextBlock Text="Installation Options" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />
                <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu shortcut" IsChecked="True" Margin="0,0,0,6" />
                <CheckBox x:Name="DesktopCheck" Content="Create Desktop shortcut" IsChecked="True" Margin="0,0,0,6" />
                <CheckBox x:Name="ShellIntegrationCheck" Content="Add 'Open in CompressIt' to video right-click menu" IsChecked="True" />
            </StackPanel>

            <!-- Step 2: Progress -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Text="Preparing installation..." FontSize="14" Margin="0,0,0,10" />
                <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,8" />
                <TextBlock x:Name="PercentText" Text="0%" FontSize="12" Foreground="#4ADE80" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- Footer Buttons -->
            <DockPanel Grid.Row="2">
                <TextBlock x:Name="FooterHint"
                          Text="Author: Devyat009"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Foreground="#64748B" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CancelBtn" Click="Cancel_Click" Appearance="Secondary" Margin="0,0,10,0" Padding="16,8">
                        <TextBlock Text="Cancel" />
                    </ui:Button>
                    <ui:Button x:Name="PrimaryBtn" Click="Primary_Click" Appearance="Primary" Padding="20,8" FontWeight="SemiBold">
                        <TextBlock x:Name="PrimaryBtnText" Text="Install" />
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
